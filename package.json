{
  "name": "warii",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @warii/server --filter @warii/web dev",
    "typecheck": "pnpm -r typecheck",
    "conferir": "pnpm --filter @warii/engine conferir",
    "test": "pnpm --filter @warii/engine --filter @warii/server test",
    "test:simulacao": "pnpm --filter @warii/engine test:simulacao",
    "build": "pnpm -r build",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
