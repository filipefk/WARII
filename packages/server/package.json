{
  "name": "@warii/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 test/entradas.test.ts test/seguranca.test.ts test/contrato.test.ts test/senha.test.ts test/tokens.test.ts test/tentativas.test.ts test/auth.test.ts test/lobby.test.ts test/socket.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@warii/engine": "workspace:*",
    "@warii/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
