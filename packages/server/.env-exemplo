# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
DATABASE_URL=postgres://warii:senha@localhost:5432/warii
# Mínimo de 32 caracteres. Gere com:
# node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Endereço do site visto pelo navegador, sem barra no fim (em dev, o Vite).
# Base dos links de ativação/redefinição de senha e origem aceita nas requisições.
URL_PUBLICA=http://localhost:5173
# Atrás de proxy reverso (Traefik do Dokploy), o número de proxies na frente do servidor (1),
# para ver o IP real do cliente. Evite "true": confia em X-Forwarded-For forjado pelo cliente.
TRUST_PROXY=false
# Espera (ms) antes de cada jogada de um robô, para quem acompanha ver a jogada. Padrão: 900.
# ROBO_ATRASO_MS=900
# Opcional: token (mínimo de 32 caracteres) que libera GET /api/metricas com
# "Authorization: Bearer <token>". Sem ele, a rota não existe.
# METRICAS_TOKEN=
